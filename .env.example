# Neon Postgres connection string — never commit the real one
DATABASE_URL=""

PORT=4000
NODE_ENV=development

# Comma-separated allowed origins for CORS (web admin, etc.)
CORS_ORIGINS=http://localhost:3000

# JWT signing secret (min 32 chars) — generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-me-with-a-long-random-string-min-32-chars
JWT_EXPIRES_IN=12h
